    "version": "0.2.0",
    "configurations": [
        {
            // "type": "pwa-node",
            "type": "node",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/app.js",
            "runtimeExecutable": "nodemon", // 추가, 노드몬으로 실행가능하도록 설정
            "restart": true // 추가, 재시작 옵션을 true로 설정
        }
    ]
}